# Copy to .env.local and fill in from Supabase: Project Settings > API Keys.
# Both values are public (they ship inside the app); data is protected by row level security.
# Leave them empty to run DebtMate local-only (no accounts).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
